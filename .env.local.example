# Firebase Analytics Configuration
# Copy this file to .env.local and fill in your Firebase project credentials
# Get these values from Firebase Console: https://console.firebase.google.com

# Firebase API Key
# From Firebase Console > Project Settings > General > Web API Key
VITE_FIREBASE_API_KEY=your-firebase-api-key-here

# Firebase Auth Domain
# From Firebase Console > Project Settings > General > Web API Key section
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# Firebase Project ID
# From Firebase Console > Project Settings > General
VITE_FIREBASE_PROJECT_ID=your-project-id

# Firebase Storage Bucket
# From Firebase Console > Project Settings > General
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# Firebase Messaging Sender ID
# From Firebase Console > Project Settings > General
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# Firebase App ID
# From Firebase Console > Project Settings > General
VITE_FIREBASE_APP_ID=your-app-id

# Firebase Measurement ID (for Analytics)
# From Firebase Console > Analytics > GA4 Measurement ID
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id
