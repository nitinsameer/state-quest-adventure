#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Run lint-staged before commit (fast checks on staged files only)
echo "🔍 Running pre-commit checks..."

# Install lint-staged if needed (or rely on npm run lint-staged)
npx lint-staged || {
  echo "❌ Lint-staged checks failed. Please fix errors before committing."
  exit 1
}

echo "✅ Pre-commit checks passed!"
echo "💡 Full test suite will run in CI/CD pipeline"
