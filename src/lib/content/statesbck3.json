        "en": {
          "title": "=% LITTI CHOKHA - Bihar's Smoky Comfort Food!",
          "emoji": "=%",
          "mainText": "Roasted wheat balls stuffed with spiced roasted gram flour, served with a smoky mashed-vegetable side - Litti Chokha is Bihar's ultimate comfort food!",
          "keyFacts": [
            {
              "text": "Litti: round wheat-flour balls stuffed with spiced sattu (roasted gram flour)! <>",
              "minAge": 3,
              "maxAge": 99
