      "funFact": {
        "en": {
          "title": "<3 CHANDIGARH - The City Beautiful!",
          "emoji": "<3",
          "mainText": "Nicknamed 'The City Beautiful', Chandigarh proves that a carefully planned city can also be one of India's cleanest, greenest, and most livable!",
          "keyFacts": [
            {
              "text": "Nicknamed 'The City Beautiful'! <3",
              "minAge": 3,
              "maxAge": 99
            },
            {
              "text": "Designed as a planned modern city with numbered sectors! =�",
              "minAge": 3,
              "maxAge": 99
            },
            {
              "text": "Shared capital of Punjab and Haryana! <�",
              "minAge": 3,
              "maxAge": 99
            },
            {
              "text": "Designed by architect Le Corbusier! <�",
              "minAge": 6,
              "maxAge": 99
            },
            {
              "text": "Capitol Complex: a UNESCO World Heritage Site! <�",
              "minAge": 8,
              "maxAge": 99
            },
            {
              "text": "Rock Garden: a huge art installation made from recycled waste! <�",
              "minAge": 3,
              "maxAge": 99
            },
            {
              "text": "Sukhna Lake: a peaceful man-made lake for walking and boating! =�",
              "minAge": 3,
              "maxAge": 99
            },
            {
              "text": "Known for its greenery, open spaces and planned layout! <3",
              "minAge": 3,
              "maxAge": 99
            },
            {
              "text": "Also a separate Union Territory, not part of either state! =�",
              "minAge": 3,
              "maxAge": 99
            },
            {
              "text": "Streets organized into numbered sectors instead of traditional neighborhoods! ="",
              "minAge": 3,
              "maxAge": 99
            }
          ],
          "coolFacts": [
            {
              "text": "Chandigarh is a Union Territory of its own, even though it serves as the capital for two neighboring states! =�",
              "minAge": 3,
              "maxAge": 99
            },
            {
              "text": "Its 'sectors' system is so organized that locals can usually find any address just from its sector number! ="",
              "minAge": 3,
              "maxAge": 99
            },
            {
              "text": "Sukhna Lake, a peaceful man-made lake, was actually created by the same team that designed the whole city! =�",
