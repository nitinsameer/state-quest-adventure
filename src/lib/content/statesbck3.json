              "minAge": 3,
              "maxAge": 99
            }
          ],
          "coolFacts": [
            {
              "text": "Dal Baati was warrior food! Soldiers ate it before battles for ENERGY! �",
              "minAge": 3,
              "maxAge": 99
            },
            {
              "text": "The 'churma' topping is made by crushing baati with ghee and sugar - it's like bread pudding! <n",
              "minAge": 3,
              "maxAge": 99
            },
            {
              "text": "Some families add dried fruits like dates and raisins to make it sweet! <o",
              "minAge": 3,
              "maxAge": 99
