      "monument": {
        "en": {
          "title": "=� TIRUMALA - Sri Venkateswara Temple",
          "emoji": "<�",
          "mainText": "Tirumala in Andhra Pradesh is home to the famous Sri Venkateswara Temple, one of Indias important pilgrimage sites.",
          "keyFacts": [
            {
              "text": "Built in 1591 by Muhammad Quli Qutb Shah! <�",
              "minAge": 8,
              "maxAge": 99
            },
            {
              "text": "Has 4 MAGNIFICENT MINARETS - each 56 meters tall! =�",
              "minAge": 3,
              "maxAge": 99
            },
            {
              "text": "The name 'Charminar' means 'Four Towers' in Persian! <�",
              "minAge": 6,
              "maxAge": 99
            },
            {
              "text": "Located in the old city of Hyderabad - heart of HISTORY! <�",
              "minAge": 3,
              "maxAge": 99
            },
            {
              "text": "One of the oldest MOSQUES in India - still functional! =L",
              "minAge": 8,
              "maxAge": 99
            },
            {
              "text": "Built as a monument to mark the end of a plague! �",
              "minAge": 8,
              "maxAge": 99
            },
            {
              "text": "The arches and balconies are BEAUTIFULLY DECORATED! <�",
              "minAge": 6,
              "maxAge": 99
            },
            {
              "text": "Over 500 YEARS OLD - a LIVING MONUMENT to history! =u",
              "minAge": 8,
              "maxAge": 99
            }
          ],
          "coolFacts": [
            {
              "text": "The 4 minarets are NOT identical - each has UNIQUE FEATURES! =",
              "minAge": 6,
              "maxAge": 99
            },
            {
              "text": "From the TOP, you can see the ENTIRE OLD CITY of Hyderabad! =�",
              "minAge": 3,
              "maxAge": 99
            },
            {
              "text": "It's made of GRANITE and LIMESTONE - weathered to GOLDEN COLOR! >�",
              "minAge": 6,
              "maxAge": 99
            },
            {
              "text": "There's a BAZAAR underneath the monument - still active after 400 years! =�",
              "minAge": 3,
              "maxAge": 99
            },
            {
              "text": "The calls to prayer from Charminar are BROADCAST LIVE - heard across Hyderabad! =�",
              "minAge": 8,
              "maxAge": 99
            },
            {
              "text": "It's one of the most PHOTOGRAPHED MONUMENTS in India! =�",
              "minAge": 3,
              "maxAge": 99
            }
          ],
          "didYouKnow": {
            "text": "The Sri Venkateswara Temple is located on the Tirumala hills near Tirupati and attracts pilgrims throughout the year.",
            "minAge": 3,
            "maxAge": 99
          },
          "tryThis": {
            "text": "Climb to the TOP of Charminar and enjoy the 360-DEGREE VIEW of Hyderabad! Absolutely SPECTACULAR! <",
            "minAge": 3,
            "maxAge": 99
          },
          "narration": "Tirumala is a hill town in Andhra Pradesh known for the Sri Venkateswara Temple. Pilgrims visit the temple throughout the year, and the surrounding hills are part of the Eastern Ghats."
        },
