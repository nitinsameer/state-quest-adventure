      "funFact": {
        "title": "<� NAGALAND - Land of Festivals and Warriors!",
        "emoji": "<�",
        "mainText": "With 16 major tribes, a legendary battle in its history, and India's most colorful tribal festival, Nagaland is one of the most unique states in the country!",
        "keyFacts": [
          {
            "text": "Home to 16 major recognized tribes! <�",
            "minAge": 3,
            "maxAge": 99
          },
          {
            "text": "Hornbill Festival: 'Festival of Festivals', every December! <�",
            "minAge": 3,
            "maxAge": 99
          },
          {
            "text": "Battle of Kohima: a turning point in World War II! <�",
            "minAge": 3,
            "maxAge": 99
          },
          {
            "text": "Traditional wooden log drums called 'Log Gongs' used for communication! >�",
            "minAge": 3,
            "maxAge": 99
          },
          {
            "text": "Naga shawls: brightly patterned, tribe-specific woven textiles! >�",
            "minAge": 3,
            "maxAge": 99
          },
          {
            "text": "Dz�kou Valley: stunning flower-filled valley, called the 'Valley of Flowers of the East'! <8",
            "minAge": 3,
            "maxAge": 99
          },
          {
            "text": "Christianity is the majority religion, unusual for India! �",
            "minAge": 3,
            "maxAge": 99
          },
          {
            "text": "Traditional Naga houses have distinctive carved wooden entrances! <�",
            "minAge": 3,
            "maxAge": 99
          },
          {
            "text": "Naga wrestling and traditional sports are festival highlights! ><",
            "minAge": 3,
            "maxAge": 99
          },
          {
            "text": "One of the greenest, most mountainous states in India! �",
            "minAge": 3,
            "maxAge": 99
          }
        ],
        "coolFacts": [
          {
            "text": "Each Naga tribe has its own unique, brightly colored woven shawl pattern that identifies it! >�",
            "minAge": 3,
            "maxAge": 99
          },
          {
            "text": "Dz�kou Valley bursts into wildflower bloom every year, earning it a flower-valley nickname! <8",
            "minAge": 3,
            "maxAge": 99
          },
          {
            "text": "Traditional 'Log Gongs' - hollowed tree trunks - were once used to send messages across villages! >�",
            "minAge": 3,
            "maxAge": 99
          },
          {
            "text": "Nagaland is one of the few Indian states with a Christian-majority population! �",
