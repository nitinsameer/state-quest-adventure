      "places": {
        "title": "<	 LIVING ROOT BRIDGES - Bridges Grown, Not Built!",
        "emoji": "<	",
        "mainText": "Deep in the rainforest, the Khasi people grow bridges out of living tree roots - some are over about a century old and still growing stronger every year!",
        "keyFacts": [
          {
            "text": "Found near Cherrapunji and Mawlynnong villages! =�",
            "minAge": 3,
            "maxAge": 99
          },
          {
            "text": "Made by training the roots of rubber fig trees across rivers! <3",
            "minAge": 3,
