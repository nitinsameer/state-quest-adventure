            {
              "text": "Hit hard by the 2004 Indian Ocean tsunami! <
",
              "minAge": 3,
              "maxAge": 99
            },
            {
              "text": "Government restricts access to protect indigenous tribes! =�",
              "minAge": 3,
              "maxAge": 99
            }
          ],
          "coolFacts": [
            {
              "text": "Barren Island is home to India's only active volcano, occasionally sending up smoke visible from passing boats! <",
              "minAge": 3,
              "maxAge": 99
            },
            {
              "text": "The Sentinelese tribe has lived in isolation for so long that outside contact is legally and strictly forbidden to protect them! =�",
              "minAge": 3,
              "maxAge": 99
            },
            {
              "text": "Out of over 500 islands in the territory, only about 37 are actually inhabited! <�",
              "minAge": 3,
